.funds-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.funds-row {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 28rpx;
}

.col {
  flex: 1;
  display: flex;
  align-items: center;
}

.col-amount {
  justify-content: flex-start;
}

.col-time {
  justify-content: center;
}

.col-name {
  justify-content: flex-end;
}

/* 金额：借用项目 price 组件，覆盖外部类以调整大小/颜色 */
.fund-amount.price {
  color: #ec8131;
  font-weight: 600;
  font-size: 30rpx;
  line-height: 1;
}

.fund-symbol.symbol {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.fund-decimal.decimal.smaller {
  font-size: 22rpx;
}

.time-text {
  font-size: 24rpx;
  color: #9b9b9b;
}

.nick-text {
  font-size: 26rpx;
  color: #333;
  max-width: 200rpx;
  text-align: right;
}

.empty-box {
  padding: 120rpx 0 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #9b9b9b;
}

.list-footer {
  padding: 24rpx 0 32rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #bbb;
}
