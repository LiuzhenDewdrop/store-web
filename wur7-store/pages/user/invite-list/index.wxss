.page {
  padding-top: 24rpx;
  min-height: 100vh;
  background: #f5f5f5;
}
.summary-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  text-align: center;
}
.summary-count {
  font-size: 56rpx;
  color: #ec8131;
  font-weight: 600;
}
.summary-count .unit {
  font-size: 28rpx;
  margin-left: 8rpx;
}
.summary-label {
  font-size: 26rpx;
  color: #9b9b9b;
  margin-top: 16rpx;
}
