.page-wrap {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.summary-label {
  font-size: 26rpx;
  color: #9b9b9b;
}

.summary-amount {
  margin: 16rpx 0 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.total-amount.price {
  color: #ec8131;
  font-weight: 700;
  font-size: 56rpx;
  line-height: 1.2;
}

.total-symbol.symbol {
  font-size: 30rpx;
  margin-right: 6rpx;
}

.total-decimal.decimal.smaller {
  font-size: 30rpx;
}

.total-amount.unfund {
  color: #ec8131;
}

.summary-tip {
  font-size: 22rpx;
  color: #bbb;
}

.list-wrap {
  background: transparent;
}
