.goods-category {
  display: flex;
}

.custom-sidebar {
  height: 100%;
}

.goods-category__right {
  height: 100%;
  flex: auto;
  width: 0;
  position: relative;
  overflow: scroll;
  -webkit-overflow-scrolling: touch;
  background-color: white;
}

.flex {
  display: flex;
}

.goods-category-normal {
  margin: 28rpx 34rpx 0rpx 32rpx;
}

.goods-category-normal-item-title {
  font-size: 28rpx;
  font-weight: 500;
}

.goods-category-normal-item-container {
  background-color: #fff;
  border-radius: 8rpx;
  padding-top: 28rpx;
  margin-top: -24rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-wrap: wrap;
}

.goods-category-normal-item-container-item {
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  width: 50%;
}

.goods-category-normal-item-container-item .image {
  width: 240rpx;
  height: 240rpx;
}

.goods-category-normal-item-container-item-title {
  justify-content: center;
  font-size: 28rpx;
  color: #666666;
  margin-top: 10rpx;
  width: 80%;
  text-align: center;
}

.goods-category .custom-sidebar {
  background-color: #f5f5f5;
}

.custom-sidebar {
  width: 180rpx;
  height: 100vh;
}

.custom-sidebar::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.goods-category-normal-item-container-item-down {
  display: flex;
  position: relative;
  flex-direction: row;
  justify-content: space-between;
  width: 80%;
}

.goods-card__add-cart {
  order: 3;
  margin: auto 0 0 auto;
  bottom: 0;
  right: 0;
}

.spec-for-price {
  font-size: 32rpx;
  white-space: nowrap;
  font-weight: 700;
  order: 1;
  color: #fa4126;
  margin: 0;
}

.spec-for-symbol {
  font-size: 32rpx;
}
