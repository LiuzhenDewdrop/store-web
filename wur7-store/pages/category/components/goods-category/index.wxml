<view class="goods-category custom-class">
  <c-sidebar custom-class="custom-sidebar" bindchange="changeCatetory" activeKey="{{activeKey}}">
    <c-sidebar-item wx:for="{{ category }}" wx:key="index" title="{{ item.categoryName }}" disabled="{{ false }}" />
  </c-sidebar>
  <view class="goods-category__right">
    <!-- <c-tabbar wx:if="{{isSlotRight}}" activeKey="{{subActiveKey}}" bindchange="onChildChange" showMore>
      <slot />
    </c-tabbar> -->
    <view class="goods-category-normal">
      <view class="goods-category-normal-item">
        <block wx:for="{{itemList}}" wx:key="index">
          <view class="flex goods-category-normal-item-title">
            {{item.category.categoryName}} 
          </view>
          <view class="goods-category-normal-item-container">
            <view
              class="goods-category-normal-item-container-item"
              wx:for="{{item.list}}"
              wx:for-index="subIndex"
              wx:key="subIndex"
              wx:for-item="subItem"
              bindtap="chooseItem"
              data-item="{{subItem}}"
            >
              <t-image src="{{subItem.thumb}}" t-class="image" />
              <view class="flex goods-category-normal-item-container-item-title"> {{subItem.itemName}} </view>
              <view class="goods-category-normal-item-container-item-down">
                <view class="goods-category-normal-item-container-item-down-left">
                <price
                  wr-class="spec-for-price"
                  symbol-class="spec-for-symbol"
                  symbol="￥"
                  price="{{ subItem.price }}"
                />
                </view>
                <view class="goods-category-normal-item-container-item-down-right">
                  <t-icon
                    class="goods-card__add-cart"
                    prefix="wr"
                    name="cartAdd"
                    id="{{subItem.id}}-cart"
                    data-id="{{subItem.id}}"
                    catchtap="handleAddCart"
                    size="48rpx"
                    color="#FA550F"
                  />
                </view>
              </view>
            </view>
            <!-- <goods-list
              wr-class="wr-goods-list"
              goodsList="{{item.list}}"
              bind:click="gotoGoodsDetail"
              bind:addcart="handleAddCart"
            /> -->
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
